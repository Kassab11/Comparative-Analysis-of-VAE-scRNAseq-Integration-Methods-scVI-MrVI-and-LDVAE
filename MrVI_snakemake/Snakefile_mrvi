rule run_mrvi:
    input:
        h5ad=lambda wc: DATASETS[wc.dataset]
    output:
        stamp="results/{mode}/{dataset}_h{h}_l{l}_n{n}_u{u}/.done"
    params:
        outdir="results/{mode}/{dataset}_h{h}_l{l}_n{n}_u{u}",
        mode_flag=lambda wc: "True" if wc.mode == "hvg" else "False"
    resources:
        gpu=1
    shell:
        """
        python ./run_mrvi.py \
            --input_file {input.h5ad} \
            --output_dir {params.outdir} \
            --encoder_n_hidden {wildcards.h} \
            --n_latent {wildcards.l} \
            --encoder_n_layers {wildcards.n} \
            --n_latent_u {wildcards.u} \
            --max_epochs 200 \
            --HVG {params.mode_flag}

        touch {output.stamp}
        """
